---
import { site } from '../lib/cliente';
const cinta = site.cinta;
---

{cinta && (
  cinta.animada ? (
    <div class="cinta cinta--animada">
      <p class="solo-lectores">{cinta.frases.join('. ')}</p>
      <div class="cinta__pista" aria-hidden="true">
        {[0, 1].map(() => (
          <ul>{cinta.frases.map((f) => <li>{f}</li>)}</ul>
        ))}
      </div>
      {cinta.nota && <p class="cinta__nota">{cinta.nota}</p>}
    </div>
  ) : (
    <div class="cinta cinta--fija">
      <div class="contenedor">
        <ul>{cinta.frases.map((f, i) => <li style={`--i: ${i}`}><span class="cinta__frase">{f}</span></li>)}</ul>
        {cinta.nota && <p class="cinta__nota">{cinta.nota}</p>}
      </div>
    </div>
  )
)}

<style>
  .cinta { border-block: 1px solid var(--line); }
  .cinta ul { display: flex; margin: 0; padding: 0; list-style: none; }
  .cinta__nota { padding-bottom: var(--s3); font-size: var(--t-s); color: var(--muted); text-align: center; }

  /* Franja fija: frases cortas y centradas, que se acomodan en varias líneas en celular.
     Una luz del color de acento recorre cada frase, una detrás de la otra, y las estrellas giran. */
  .cinta--fija {
    position: relative;
    background:
      radial-gradient(60% 140% at 50% 0%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%),
      var(--surface-alt);
  }
  .cinta--fija::before {
    content: ''; position: absolute; inset: -1px 0 auto; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }
  .cinta--fija ul { flex-wrap: wrap; justify-content: center; gap: var(--s2) var(--s5); padding-block: var(--s5) var(--s2); }
  .cinta--fija li {
    display: flex; align-items: center; gap: var(--s5);
    font: 800 clamp(14px, 1.6vw, 18px) / 1.3 var(--font-display); letter-spacing: 0.16em; text-transform: uppercase;
  }
  .cinta--fija li + li::before {
    content: '✦'; display: inline-block; color: var(--accent); font-size: 0.85em; letter-spacing: 0;
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  /* Celular angosto: una frase por renglón, sin estrellas (si no, una queda colgando al empezar un renglón). */
  @media (max-width: 599px) {
    .cinta--fija ul { flex-direction: column; align-items: center; gap: var(--s1); }
    .cinta--fija li + li::before { display: none; }
  }
  .cinta--fija .cinta__nota { padding-top: var(--s2); padding-bottom: var(--s4); }
  .cinta--fija:not(:has(.cinta__nota)) ul { padding-bottom: var(--s5); }
  @media (prefers-reduced-motion: no-preference) {
    .cinta__frase {
      background: linear-gradient(100deg, var(--ink) 40%, var(--accent) 50%, var(--ink) 60%) 100% 0 / 300% 100%;
      -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: brillo 6s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.6s);
    }
    @keyframes brillo { 0%, 30% { background-position: 100% 0; } 70%, 100% { background-position: 0 0; } }
    .cinta--fija li + li::before { animation: girar 8s linear infinite; }
    @keyframes girar { to { rotate: 1turn; } }
  }

  /* Cinta en movimiento (cinta.animada = true). */
  .cinta--animada { overflow: hidden; background: var(--accent); color: var(--accent-ink); border-color: var(--ink); }
  .cinta__pista { display: flex; width: max-content; }
  .cinta--animada li {
    display: flex; align-items: center; gap: var(--s5); padding: var(--s3) var(--s5) var(--s3) 0;
    font: 700 var(--t-m) / 1.2 var(--font-display); white-space: nowrap; text-transform: uppercase; letter-spacing: 0.02em;
  }
  .cinta--animada li::after { content: '✦'; font-size: var(--t-s); }
  .cinta--animada .cinta__nota { color: inherit; padding-top: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .cinta__pista { animation: correr 28s linear infinite; }
    @keyframes correr { to { translate: -50% 0; } }
  }
  @media (prefers-reduced-motion: reduce) { .cinta__pista > ul + ul { display: none; } }
</style>
