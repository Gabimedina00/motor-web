---
import { Image } from 'astro:assets';
import { site, foto } from '../lib/cliente';
import { bloquesDe } from '../themes';
import { linkWhatsApp } from '../lib/whatsapp';

const activos = bloquesDe(site);
const h = site.hero;
const principal = activos.includes('Catalogo')
  ? { href: '#catalogo', texto: h.botonPrincipal ?? (site.tema === 'servicios' ? 'Ver servicios' : 'Ver catálogo') }
  : activos.includes('Galeria')
    ? { href: '#galeria', texto: h.botonPrincipal ?? 'Ver trabajos' }
    : undefined;
const emblema = h.efecto === 'emblema' && h.foto;
// Con esquema claro, la portada del emblema invierte los colores (fondo oscuro).
const invertida = emblema && site.marca.esquema === 'claro';
// "Tu trabajo merece *buenos insumos.*": las partes impares (entre asteriscos) se resaltan.
const titulo = h.titulo.split('*');
---

<section class:list={['hero', { 'hero--emblema': emblema, 'hero--oscuro': invertida }]} data-hero>
  {emblema && <div class="hero__ambiente" aria-hidden="true"></div>}
  <div class="contenedor hero__grilla">
    <div class="hero__texto">
      {h.promo && <p class="hero__promo">{h.promo}</p>}
      <h1>{titulo.map((t, i) => (i % 2 ? <span class="hero__resalte">{t}</span> : t))}</h1>
      <p class="hero__bajada">{h.bajada}</p>
      <div class="hero__acciones">
        {principal && <a class="boton" href={principal.href}>{principal.texto}</a>}
        <a class="boton boton--secundario" href={linkWhatsApp(site.contacto.whatsapp)} target="_blank" rel="noopener">
          {h.botonWhatsApp ?? 'Escribir por WhatsApp'}
        </a>
      </div>
      {h.apoyo && <p class="hero__apoyo">{h.apoyo}</p>}
    </div>
    {emblema ? (
      <div class="hero__escena" data-escena>
        <div class="hero__flotar">
          <div class="hero__inclinar" data-inclinar>
            <Image
              class="hero__emblema"
              src={foto(h.foto!)}
              alt={h.alt ?? ''}
              widths={[220, 440, 660, 920]}
              sizes="(min-width: 960px) 460px, 220px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
        <div class="hero__sombra" aria-hidden="true"></div>
      </div>
    ) : h.foto && (
      <Image
        class="hero__foto"
        src={foto(h.foto)}
        alt={h.alt ?? ''}
        widths={[480, 800, 1100]}
        sizes="(min-width: 960px) 540px, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
  </div>
</section>

<style>
  .hero { position: relative; padding-block: var(--s6) var(--s7); }
  .hero__promo {
    display: inline-block; margin-bottom: var(--s4); padding: var(--s1) var(--s3);
    border: 1px solid currentColor; border-radius: 999px;
    font-size: var(--t-s); font-weight: 600; letter-spacing: 0.02em;
  }
  .hero__grilla { display: grid; gap: var(--s6); align-items: center; }
  @media (min-width: 960px) { .hero__grilla { grid-template-columns: 1.1fr 1fr; gap: var(--s7); } }
  .hero h1 {
    font-size: clamp(40px, 9vw, 76px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 0.98;
  }
  .hero__resalte { color: var(--brand); }
  .hero__bajada { margin-top: var(--s4); font-size: var(--t-m); color: var(--muted); max-width: 44ch; }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s5); }
  .hero__apoyo { margin-top: var(--s4); font-size: var(--t-s); color: var(--muted); }
  .hero__foto {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: calc(var(--radius-card) * 2);
  }

  /* Portada con emblema (hero.efecto = "emblema"). */
  .hero--emblema { overflow: hidden; isolation: isolate; padding-block: var(--s6) var(--s7); }
  @media (min-width: 960px) { .hero--emblema { padding-block: var(--s8); } }
  .hero--emblema h1 { font-size: clamp(40px, 6.2vw, 84px); font-weight: 750; letter-spacing: -0.03em; line-height: 1; }
  .hero--emblema .hero__promo {
    border-color: var(--line); color: var(--muted);
    font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .hero--emblema .hero__bajada { max-width: 46ch; }
  /* En celular el texto y el botón van primero; el emblema queda chico debajo. */
  .hero__escena { position: relative; justify-self: center; width: clamp(180px, 52vw, 220px); }
  @media (min-width: 960px) { .hero__escena { width: min(100%, 460px); } }
  .hero__inclinar { transition: transform 0.35s ease-out; will-change: transform; }
  .hero__emblema { width: 100%; height: auto; }
  .hero__sombra {
    position: absolute; left: 18%; right: 18%; bottom: -8%; height: 10%; border-radius: 50%; z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--brand) 30%, transparent), transparent);
    filter: blur(8px);
  }
  /* Luces de ambiente: dos manchas muy suaves (marca y acento) detrás del emblema. */
  .hero__ambiente { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero__ambiente::before, .hero__ambiente::after {
    content: ''; position: absolute; width: 60vmax; height: 60vmax; border-radius: 50%; opacity: 0.16;
  }
  .hero__ambiente::before { right: -18vmax; top: -22vmax; background: radial-gradient(closest-side, var(--brand), transparent); }
  .hero__ambiente::after { right: 6vmax; bottom: -34vmax; background: radial-gradient(closest-side, var(--accent), transparent); opacity: 0.1; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__flotar { animation: flotar 7s ease-in-out infinite; }
    .hero__ambiente::before { animation: luz 18s ease-in-out infinite alternate; }
    .hero__ambiente::after { animation: luz 22s ease-in-out infinite alternate-reverse; }
    @keyframes flotar { 50% { translate: 0 -10px; } }
    @keyframes luz { to { translate: -6vmax 4vmax; } }
    /* Fuera de vista las animaciones se pausan. */
    .hero[data-fuera] .hero__flotar, .hero[data-fuera] .hero__ambiente::before, .hero[data-fuera] .hero__ambiente::after {
      animation-play-state: paused;
    }
  }

  /* Esquema oscuro: el resaltado del título es cromado (plata con brillo). */
  :global([data-esquema='oscuro']) .hero__resalte {
    background: linear-gradient(100deg, var(--cromo-claro) 0%, var(--cromo-medio) 42%, var(--cromo-claro) 68%, var(--cromo-medio) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* Esquema claro con emblema: portada invertida sobre ink. */
  .hero--oscuro { background: var(--ink); color: var(--surface); }
  .hero--oscuro .hero__bajada, .hero--oscuro .hero__apoyo, .hero--oscuro .hero__promo { color: color-mix(in srgb, var(--surface) 78%, var(--ink)); }
  .hero--oscuro .hero__resalte { color: var(--accent); }
  .hero--oscuro .boton { background: var(--surface); border-color: var(--surface); color: var(--ink); }
  .hero--oscuro .boton:hover { background: var(--cromo-claro); border-color: var(--cromo-claro); }
  .hero--oscuro .boton--secundario { background: transparent; color: var(--surface); }
  .hero--oscuro .boton--secundario:hover { background: color-mix(in srgb, var(--surface) 12%, transparent); color: var(--surface); }
  .hero--oscuro :focus-visible { outline-color: var(--surface); }
</style>

<script>
  // El emblema se inclina un poco hacia el mouse (máximo 5°) mientras el puntero está en la portada.
  // Solo con mouse y sin pedido de menos movimiento. Fuera de vista, las animaciones se pausan.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const escena = hero?.querySelector<HTMLElement>('[data-escena]');
  const inclinar = hero?.querySelector<HTMLElement>('[data-inclinar]');
  if (hero && escena && inclinar) {
    new IntersectionObserver(([e]) => hero.toggleAttribute('data-fuera', !e.isIntersecting)).observe(hero);
    const puedeInclinar = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    let x = 0;
    let y = 0;
    let pendiente = false;
    const aplicar = () => {
      pendiente = false;
      inclinar.style.transform = `perspective(900px) rotateX(${(-y * 5).toFixed(2)}deg) rotateY(${(x * 5).toFixed(2)}deg) scale(1.025)`;
    };
    hero.addEventListener('pointermove', (e) => {
      if (!puedeInclinar.matches) return;
      const caja = escena.getBoundingClientRect();
      const limitar = (n: number) => Math.max(-1, Math.min(1, n));
      x = limitar((e.clientX - (caja.left + caja.width / 2)) / (caja.width / 2));
      y = limitar((e.clientY - (caja.top + caja.height / 2)) / (caja.height / 2));
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(aplicar);
      }
    });
    hero.addEventListener('pointerleave', () => (inclinar.style.transform = ''));
  }
</script>
