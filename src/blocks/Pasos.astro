---
import { site } from '../lib/cliente';
const pasos = site.pasos ?? [];
---

{pasos.length > 0 && (
  <section id="como-comprar" class="seccion pasos" aria-labelledby="pasos-titulo">
    <div class="contenedor">
      <h2 id="pasos-titulo" class="seccion__titulo">Cómo comprar</h2>
      <ol class="pasos__lista">
        {pasos.map((p, i) => (
          <li class="pasos__paso">
            <span class="pasos__numero" aria-hidden="true">{i + 1}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .pasos__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }
  @media (min-width: 760px) { .pasos__lista { grid-template-columns: repeat(3, 1fr); gap: var(--s5); } }
  .pasos__paso {
    display: grid; gap: var(--s2); align-content: start;
    padding: var(--s5); border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface-alt);
  }
  .pasos__numero {
    display: grid; place-items: center; width: 36px; height: 36px; margin-bottom: var(--s2); border-radius: 50%;
    background: var(--brand); color: var(--brand-ink); font-weight: 700;
  }
  .pasos__paso p { color: var(--muted); }
</style>
