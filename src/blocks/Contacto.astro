---
import { site } from '../lib/cliente';
import { linkWhatsApp } from '../lib/whatsapp';
const c = site.contacto;
---

<section id="contacto" class="seccion contacto" aria-labelledby="contacto-titulo">
  <div class="contenedor contacto__caja">
    <div>
      <h2 id="contacto-titulo">¿Tenés una consulta?</h2>
      <p>{site.tema === 'tienda' ? 'Escribinos y te ayudamos con tu pedido.' : 'Escribinos por WhatsApp y te ayudamos.'}</p>
    </div>
    <div class="contacto__acciones">
      <a class="boton contacto__wa" href={linkWhatsApp(c.whatsapp, `Hola ${site.nombre}! Tengo una consulta.`)} target="_blank" rel="noopener">
        Escribir por WhatsApp
      </a>
      {c.telefono && <a class="contacto__link" href={`tel:${c.telefono.replace(/\s/g, '')}`}>Llamar al {c.telefono}</a>}
      {c.email && <a class="contacto__link" href={`mailto:${c.email}`}>{c.email}</a>}
    </div>
  </div>
</section>

<style>
  .contacto__caja {
    display: grid; gap: var(--s5); align-items: center;
    padding: var(--s6); border-radius: calc(var(--radius-card) * 2);
    background: var(--brand); color: var(--brand-ink);
  }
  @media (min-width: 760px) { .contacto__caja { grid-template-columns: 1fr auto; padding: var(--s7); } }
  .contacto__caja h2 { color: inherit; }
  .contacto__caja p { margin-top: var(--s2); opacity: 0.9; font-size: var(--t-m); }
  .contacto__acciones { display: grid; gap: var(--s3); justify-items: start; }
  .contacto__wa { background: var(--brand-ink); border-color: var(--brand-ink); color: var(--brand-strong); }
  .contacto__wa:hover { background: var(--surface-alt); border-color: var(--surface-alt); color: var(--brand-strong); }
  .contacto__link { color: inherit; }
  .contacto :global(:focus-visible) { outline-color: currentColor; }
  /* Esquema oscuro: la caja es una superficie elevada y el botón usa el color de marca. */
  :global([data-esquema='oscuro']) .contacto__caja {
    background: linear-gradient(135deg, var(--surface-raised), var(--surface-alt)); color: var(--ink);
    border: 1px solid var(--line);
  }
  :global([data-esquema='oscuro']) .contacto__caja p { color: var(--muted); opacity: 1; }
  :global([data-esquema='oscuro']) .contacto__wa { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
  :global([data-esquema='oscuro']) .contacto__wa:hover { background: var(--brand-strong); border-color: var(--brand-strong); }
  :global([data-esquema='oscuro']) .contacto :global(:focus-visible) { outline-color: var(--focus); }
</style>
