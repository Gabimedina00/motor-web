{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "aviso": {
      "type": "string"
    },
    "categorias": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "nombre"
        ]
      }
    },
    "productos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "nombre": {
            "type": "string",
            "minLength": 1
          },
          "categoria": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "foto": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "etiqueta": {
            "type": "string"
          },
          "fondo": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "idealPara": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disponible": {
            "default": true,
            "type": "boolean"
          },
          "opciones": {
            "type": "object",
            "properties": {
              "colores": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "nombre": {
                      "type": "string",
                      "minLength": 1
                    },
                    "muestra": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "talles": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "nombre",
                    "muestra"
                  ],
                  "additionalProperties": false
                }
              },
              "talles": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unidad": {
                "type": "object",
                "properties": {
                  "singular": {
                    "type": "string",
                    "minLength": 1
                  },
                  "plural": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "singular",
                  "plural"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "variantes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string",
                  "minLength": 1
                },
                "precio": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "precioAntes": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unidades": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "nombre",
                "precio"
              ]
            }
          }
        },
        "required": [
          "id",
          "nombre",
          "categoria",
          "variantes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "categorias",
    "productos"
  ],
  "additionalProperties": false
}
